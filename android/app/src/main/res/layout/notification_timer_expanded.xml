<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timer_card"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="18dp" android:background="@drawable/timer_card_expanded">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_notification" android:importantForAccessibility="no" />
        <TextView android:id="@+id/timer_header" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:textSize="10sp" android:letterSpacing="0.08" android:textColor="#CCCCCA" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/timer_session" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="140dp" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="#D6E4AA" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:background="@drawable/timer_session_badge" />
    </LinearLayout>
    <TextView android:id="@+id/timer_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textSize="17sp" android:textColor="#F6F6F3" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <Chronometer android:id="@+id/timer_elapsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="36sp" android:fontFamily="sans-serif-medium" android:textColor="#9BBB59" android:maxLines="1" />
        <TextView android:id="@+id/timer_total" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginBottom="6dp" android:textSize="14sp" android:textColor="#AFB1AC" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ProgressBar android:id="@+id/timer_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="3dp" android:progressDrawable="@drawable/timer_progress_expanded" android:indeterminate="false" />
    <RelativeLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp">
        <Chronometer android:id="@+id/timer_remaining" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#A7ABA1" android:layout_alignParentStart="true" android:layout_toStartOf="@id/timer_toggle" android:maxLines="2" android:ellipsize="end" />
        <ImageButton android:id="@+id/timer_toggle" android:layout_width="48dp" android:layout_height="48dp" android:layout_centerHorizontal="true" android:padding="14dp" android:background="@drawable/timer_toggle_background" android:src="@drawable/ic_overlay_pause" android:contentDescription="@string/timer_notification_pause" />
    </RelativeLayout>
</LinearLayout>
