# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/android/build/
/coverage/
/test/**
!/test/app/
!/test/app/app_controller_timer_restore_test.dart
!/test/presentation/
!/test/presentation/login/
!/test/presentation/login/login_controller_test.dart
!/test/core/
!/test/core/services/
!/test/core/services/local_storage/
!/test/core/services/local_storage/app_local_storage_service_test.dart

# Local AI assistant settings
.claude/settings.local.json

# Local environment values
lib/env/*.env
!lib/env/*.env.example

# Android upload signing material
android/key.properties
android/*.jks
android/*.keystore

# Local Google Play capture and generated image artifacts
/docs/play-store/screenshots/
/docs/play-store/*.png
/docs/timing_feature_graphic_1024x500.png

# The canonical Supabase schema is the ordered sections in backend/schema/.

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
